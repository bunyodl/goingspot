{
  "name": "goingspot",
  "version": "1.0.1",
  "main": "index.js",
  "repository": "https://github.com/bunyodl/goingspot.git",
  "author": "BunyodL <bunyodcode@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "tsx watch --inspect ./src/index.ts",
    "prebuild": "npm run typecheck",
    "build": "tsup && tsc-alias && npm run copy:sql",
    "postbuild": "echo build was successful",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "copy:sql": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome check --write --linter-enabled=false .",
    "seed": "tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "copyfiles": "2.4.1",
    "tsc-alias": "1.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "1.1.22"
  }
}
