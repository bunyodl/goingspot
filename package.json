{
  "name": "goingspot",
  "version": "1.0.1",
  "main": "index.js",
  "repository": "https://github.com/bunyodl/goingspot.git",
  "author": "BunyodL <bunyodcode@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect ./src/index.ts",
    "prebuild": "npm run typecheck",
    "build": "tsup && tsc-alias && npm run copy:sql",
    "postbuild": "echo build was successful",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "copy:sql": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome check --write --linter-enabled=false .",
    "seed": "tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jose": "^6.2.4",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "tsc-alias": "^1.8.17",
    "tsup": "^8.5.1",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3"
  }
}
